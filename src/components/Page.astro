---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { t, contact, WHY_ICONS, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const marquee = [...c.marquee, ...c.marquee];
const pad = (i: number) => '0' + (i + 1);
const indColors = ['#E3C79A', '#1F4E8C', '#B8925A', '#7FB2FF', '#0B1E35'];
---
<Base lang={lang}>
  <Header lang={lang} />
  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-top">
          <img class="hero-mark" src="/images/sutric-mark-white.png" alt="" aria-hidden="true" />
          <h1>{c.hero.title1} <span>{c.hero.title2}</span></h1>
          <p class="lead"><span>{c.hero.lead}</span></p>
          <div class="actions">
            <a href="#services" class="btn btn--light">{c.hero.primary}<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" class="arr-ico" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5"></path></svg></a>
            <a href="#contact" class="btn btn--ghost">{c.hero.secondary}</a>
          </div>
        </div>
        <div class="flow"><sutric-flows lang={lang}></sutric-flows></div>
      </div>
      <div class="marquee" aria-hidden="true">
        <div class="track">
          {marquee.map((m) => <span class="m" dir={c.dir}>{m}<i></i></span>)}
        </div>
      </div>
    </section>

    <section id="about" class="about">
      <div class="container grid2 about-top">
        <div class="stack">
          <div class="eyebrow">{c.about.eyebrow}</div>
          <h2 class="h2">{c.about.title}</h2>
        </div>
        <div class="stack">
          <p class="body-lg">{c.about.text}</p>
          <div class="chips">{c.about.items.map((x) => <span>{x}</span>)}</div>
        </div>
      </div>
      <div class="container">
        <div class="vision">
          <div class="v1">
            <div class="eyebrow" style="color:var(--amber)">{c.about.visionLabel}</div>
            <p>{c.about.vision}</p>
          </div>
          <div class="v2">
            <p>“{c.about.quote}”</p>
            <span>— {c.footer}</span>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="services">
      <div class="container">
        <div class="sec-head bordered">
          <h2 class="eyebrow">{c.services.eyebrow}</h2>
        </div>
        <div class="svc-list">
          <article class="svc">
            <div class="svc-head"><h3>{c.services.s0.title}</h3></div>
            <div class="svc-body">
              <p>{c.services.s0.text}</p>
              <div class="svc-note"><i></i>{c.services.s0.note}</div>
            </div>
          </article>
          <article class="svc">
            <div class="svc-head"><h3>{c.services.s1.title}</h3></div>
            <div class="svc-body">
              <p>{c.services.s1.text}</p>
              <div class="svc-links">{c.services.s1.points.map((pt) => <a href={pt.href}><span class="svc-lbl"><span>{pt.label}</span></span><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" class="svc-ico" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5"></path></svg></a>)}</div>
            </div>
          </article>
          <article class="svc">
            <div class="svc-head"><h3>{c.services.s2.title}</h3></div>
            <div class="svc-body"><p>{c.services.s2.text}</p></div>
          </article>
          <article class="svc">
            <div class="svc-head"><h3>{c.services.s3.title}</h3></div>
            <div class="svc-body"><p>{c.services.s3.text}</p><a class="svc-cta" href="#contact">{c.cta}<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" class="svc-ico" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5"></path></svg></a></div>
          </article>
        </div>
      </div>
    </section>

    <section id="solutions" class="sols">
      <div class="container">
        <div class="stack-sm sols-head">
          <h2 class="eyebrow">{c.solutions.eyebrow}</h2>
        </div>
        {c.solutions.items.map((s) => (
          <article id={'sol-' + s.id} class="sol">
            <div class="sol-info">
              <div class="sol-top">
                <div class="stack-sm"><h3>{s.title}</h3><div class="sol-meta"><em class={s.ready ? 'sbadge sbadge--ready' : 'sbadge sbadge--soon'}>{s.status}</em></div></div>
                <p>{s.desc}</p>
              </div>
              <div class="sol-bottom">
                <div class="sol-col"><div class="sol-label">{c.solutions.who}</div><div class="sol-chips">{s.who.map((w) => <span>{w}</span>)}</div></div>
                <div class="sol-col"><div class="sol-label">{c.solutions.ben}</div><ul>{s.benefits.map((b) => <li><i></i>{b}</li>)}</ul></div>
              </div>
            </div>
            <div class="sol-flow"><sutric-flows lang={lang} flow={s.id} bare=""></sutric-flows></div>
            {s.shots && <div class="sol-shots">{s.shots.map((sh) => <figure><div class="sol-shot"><img src={sh.src} alt={sh.cap} loading="lazy" /></div><figcaption>{sh.cap}</figcaption></figure>)}</div>}
          </article>
        ))}
      </div>
    </section>

    <section id="capabilities" class="caps">
      <div class="container grid2 caps-inner">
        <div class="stack-lg">
          <div class="stack-sm">
            <div class="eyebrow">{c.caps.eyebrow}</div>
            <h2 class="h2">{c.caps.title}</h2>
          </div>
          <div class="cap-list">
            {c.caps.items.map((x) => <div class="cap"><strong>{x.title}</strong><span>{x.text}</span></div>)}
          </div>
        </div>
        <div class="cap-img"><img src="/images/energy-management-dashboard.jpg" alt={c.caps.imgAlt} loading="lazy" /></div>
      </div>
    </section>

    <section id="how" class="how">
      <div class="container">
        <div class="sec-head">
          <div class="eyebrow eyebrow--dark">{c.how.eyebrow}</div>
          <h2 class="h2">{c.how.title}</h2>
        </div>
        <div class="steps">
          {c.how.steps.map((s, i) => (
            <div class={i === 0 ? 'step first' : 'step'}>
              <i></i>
              <span class="n">{pad(i)}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
        <div class="works">
          <span>{c.how.worksWith}</span>
          <div class="brands">{c.how.brands.map((b) => <span>{b}</span>)}</div>
        </div>
      </div>
    </section>

    <section id="why" class="why">
      <div class="container">
        <div class="sec-head">
          <div class="eyebrow">{c.why.eyebrow}</div>
          <h2 class="h2" style="max-width:760px">{c.why.title}</h2>
        </div>
        <div class="why-grid">
          {c.why.items.map((label, i) => (
            <div class="why-card">
              <span class="ic"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={WHY_ICONS[i]}></path></svg></span>
              <span class="lbl">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="container grid2 contact-inner">
        <div class="stack-lg start">
          <h2 class="contact-title">{c.contact.title}</h2>
          <p class="body">{c.contact.lead}</p>
          <a href={`mailto:${contact.email}`} class="btn btn--dark">{c.contact.button}<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" class="arr-ico" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5"></path></svg></a>
        </div>
        <div class="rows">
          <div class="row"><span class="k"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v14H3z M3 6l9 7 9-7"></path></svg>{c.contact.business}</span><a href={`mailto:${contact.email}`} class="v mono">{contact.email}</a></div>
          <div class="row"><span class="k"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"></path></svg>{c.contact.phone}</span><span class="v mono phones">{contact.phones.map((p) => <a href={`tel:${p}`}>{p}</a>)}</span></div>
          <div class="row"><span class="k"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V21h-4z"/></svg>{c.contact.linkedin}</span><a href="https://www.linkedin.com/company/sutric-advanced-technologies/" target="_blank" rel="noopener" class="v li">Sutric Advanced Technologies</a></div>
          <div class="row"><span class="k"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"></path></svg>{c.contact.office}</span><span class="v addr">{c.contact.address}</span></div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <script is:inline src="/sutric-flows.js" defer></script>
</Base>

<style>
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); }
  .stack { display: flex; flex-direction: column; gap: 22px; }
  .stack-sm { display: flex; flex-direction: column; gap: 14px; }
  .stack-lg { display: flex; flex-direction: column; gap: 28px; }
  .start { align-items: flex-start; }
  .sec-head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 56px; }
  .sec-head.bordered { padding-top: 56px; border-top: 1px solid var(--line-2); margin-bottom: 44px; }
  .sec-head.narrow { max-width: 760px; }

  .hero { position: relative; background: var(--navy) radial-gradient(ellipse 70% 55% at 50% 72%, rgba(61,130,240,.22), transparent 70%); color: var(--on-dark); overflow: hidden; }
  .hero-mark { position: absolute; z-index: -1; top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(70vw, 85svh, 980px); height: auto; opacity: .045; pointer-events: none; }
  .hero-inner { position: relative; padding-block: 0 clamp(80px, 9vw, 120px); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero-top { position: relative; isolation: isolate; min-height: calc(100svh - var(--header-h)); width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(20px, 3.5svh, 44px); padding-block: clamp(24px, 5svh, 48px); }
  .hero h1 { font-size: clamp(48px, min(9vw, 17svh), 190px); line-height: 1.05; font-weight: 700; text-transform: uppercase; text-wrap: balance; }
  html[lang='en'] .hero h1 { font-size: clamp(38px, min(7vw, 14svh), 150px); font-style: italic; letter-spacing: -0.03em; }
  .hero h1 span { color: var(--bright); }
  .lead { max-width: 1200px; font-size: clamp(19px, min(1.9vw, 3.5svh), 36px); font-weight: 300; color: var(--on-dark-3); line-height: 1.75; text-wrap: balance; }
  .lead span { text-decoration: underline; text-decoration-color: var(--bright); text-decoration-thickness: 2px; text-underline-offset: 10px; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 4px; }
  .flow { width: 100%; max-width: min(1320px, calc((100svh - var(--header-h) - 128px) * 1.5 + 80px)); margin-top: 24px; min-height: 200px; box-sizing: border-box; padding: clamp(20px, 3vw, 40px); background: rgba(14,38,66,.72); border: 1px solid rgba(127,178,255,.22); border-radius: 16px; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
  @media (min-width: 1100px) {
    .hero-inner { max-width: 1760px; display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); align-items: center; gap: clamp(40px, 4vw, 96px); min-height: calc(100svh - var(--header-h)); padding-block: clamp(32px, 6svh, 72px); text-align: start; }
    .hero-top { min-height: 0; width: fit-content; max-width: 100%; justify-self: center; align-items: flex-start; padding-block: 0; }
    .hero h1 { font-size: clamp(44px, min(4.6vw, 14svh), 86px); }
    html[lang='en'] .hero h1 { font-size: clamp(38px, min(4.4vw, 10svh), 110px); }
    .lead { max-width: 780px; font-size: clamp(18px, min(1.45vw, 3svh), 30px); }
    .actions { justify-content: flex-start; }
    .flow { max-width: none; margin-top: 0; padding: clamp(16px, 1.6vw, 32px); }
    .hero-mark { width: min(115%, 85svh); }
  }
  .sols { padding: 110px 0 40px; background: var(--navy); color: #F4EEE4; }
  .sols .eyebrow { color: #7FB2FF; }
  .sols-head { margin-bottom: 24px; }
  .sol { display: flex; flex-direction: column; gap: 36px; margin-top: 32px; padding: clamp(24px, 3vw, 56px); background: rgba(14,38,66,.55); border: 1px solid rgba(127,178,255,.2); border-top: 3px solid #E3C79A; border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.25); scroll-margin-top: calc(var(--header-h) + 24px); }
  .sol:last-of-type { margin-bottom: 72px; }
  .sol-top, .sol-bottom { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 24px 64px; }
  .sol-top { align-items: end; }
  .sol-top .stack-sm { width: 100%; }
  .sol h3 { margin: 0; font-size: clamp(26px, 2.8vw, 38px); font-weight: 700; line-height: 1.25; text-wrap: balance; }
  .sol-top p { margin: 0; font-size: clamp(18px, 1.188vw, 22px); color: #BFCBDB; line-height: 1.75; text-wrap: pretty; }
  .sol-flow { box-sizing: border-box; padding: clamp(16px, 2.5vw, 32px); background: rgba(14,38,66,.72); border: 1px solid rgba(127,178,255,.22); border-radius: 16px; min-height: 200px; }
  .sol-col { display: flex; flex-direction: column; gap: 18px; }
  .sol-label { font-size: clamp(14px, 0.924vw, 18px); font-weight: 700; color: #7FB2FF; }
  .sol-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .sol-chips span { padding: 9px 16px; border: 1px solid rgba(127,178,255,.35); font-size: clamp(15px, 0.99vw, 19px); font-weight: 500; }
  .sol ul { list-style: none; margin: 0; padding: 0; }
  .sol li { display: flex; align-items: center; gap: 14px; padding: 12px 0; border-bottom: 1px solid rgba(244,238,228,.12); font-size: clamp(16px, 1.056vw, 20px); font-weight: 500; }
  .sol li i { width: 8px; height: 8px; flex: none; background: #E3C79A; transform: rotate(45deg); }
  .marquee { border-top: 1px solid rgba(244,238,228,.12); background: var(--navy-2); overflow: hidden; direction: ltr; }
  .track { display: flex; width: max-content; animation: sutricMarquee 38s linear infinite; }
  .m { display: inline-flex; align-items: center; gap: 28px; padding: 22px 28px; font-size: clamp(18px, 1.188vw, 22px); font-weight: 500; color: var(--on-dark); white-space: nowrap; }
  .m i { width: 8px; height: 8px; background: var(--amber); border-radius: 50%; }

  .about { padding: 120px 0; background: var(--paper); }
  .about-top { gap: 72px; align-items: end; }
  .body-lg { font-size: clamp(19px, 1.254vw, 24px); color: var(--ink-2); line-height: 1.75; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chips span { padding: 10px 18px; background: var(--white); border: 1px solid var(--line); font-size: clamp(15px, 0.99vw, 19px); font-weight: 600; }
  .vision { margin-top: 72px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); background: var(--navy); color: var(--on-dark); }
  .v1 { padding: 44px; display: flex; flex-direction: column; gap: 16px; border-inline-end: 1px solid rgba(244,238,228,.12); }
  .v1 p { font-size: clamp(20px, 1.75vw, 32px); font-weight: 500; line-height: 1.5; text-wrap: pretty; }
  .v2 { padding: 44px; display: flex; flex-direction: column; justify-content: center; gap: 18px; background: var(--navy-2); }
  .v2 p { font-size: clamp(18px, 1.45vw, 27px); font-weight: 300; line-height: 1.6; color: var(--on-dark-2); }
  .v2 span { font-size: clamp(14px, 0.924vw, 18px); font-weight: 600; color: var(--amber); }

  .services { padding: 0 0 120px; background: var(--paper); }
  .services .sec-head { margin-bottom: 32px; }
  .svc-list { display: flex; flex-direction: column; gap: 24px; }
  .svc { display: flex; flex-wrap: wrap; gap: 24px 48px; padding: clamp(24px, 2.8vw, 48px); background: var(--white); border: 1px solid var(--line); border-top: 3px solid #B8925A; border-radius: 18px; box-shadow: 0 14px 36px rgba(11,30,53,.06); }
  .svc .svc-links a, .svc .svc-note { background: var(--paper); }
  .svc .svc-links a:hover { background: var(--navy); border-color: var(--navy); color: var(--paper); }
  .svc-head { flex: 1 1 300px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .svc h3 { font-size: clamp(26px, 2.6vw, 36px); font-weight: 700; line-height: 1.2; color: var(--navy); text-wrap: balance; }
  .svc-body { flex: 1.6 1 440px; display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
  .svc-body p { font-size: clamp(18px, 1.188vw, 22px); color: var(--ink-2); line-height: 1.75; max-width: 780px; }
  .svc-links { align-self: stretch; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .svc-links a { display: flex; align-items: center; gap: 14px; padding: 20px 22px; background: var(--white); border: 1px solid var(--line); font-size: clamp(16px, 1.056vw, 20px); font-weight: 600; line-height: 1.45; color: var(--navy); text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
  .svc-links a:hover { background: var(--navy); color: var(--paper); border-color: var(--navy); }
  .svc-lbl { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .badge { font-style: normal; font-size: 12px; font-weight: 700; padding: 3px 8px; }
  .badge--ready { background: #E3C79A; color: var(--navy); }
  .badge--soon { padding: 2px 8px; border: 1px solid #B8925A; color: #8A6A3C; }
  .svc-links a:hover .badge--soon { color: #E3C79A; }
  .sol-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 28px 20px; align-items: start; }
  .sol-shots figure { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .sol-shot { background: #F4F6F8; border: 1px solid rgba(127,178,255,.22); border-radius: 12px; overflow: hidden; }
  .sol-shot img { width: 100%; height: auto; display: block; }
  .sol-shots figcaption { font-size: clamp(15px, 0.99vw, 19px); font-weight: 500; color: var(--on-dark-2); line-height: 1.5; }
  .sol-meta { display: flex; align-items: center; gap: 14px; }
  .sbadge { font-style: normal; font-size: 13px; font-weight: 700; padding: 4px 10px; }
  .sbadge--ready { background: #E3C79A; color: var(--navy); }
  .sbadge--soon { padding: 3px 10px; border: 1px solid rgba(227,199,154,.6); color: #E3C79A; }
  .sol-info { display: flex; flex-direction: column; gap: 36px; }
  @media (min-width: 1100px) {
    .sol { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 13fr); grid-template-areas: "info flow" "shots shots"; align-items: center; gap: 32px clamp(36px, 3.5vw, 72px); padding: clamp(28px, 1.8vw, 36px) clamp(32px, 2.6vw, 48px); }
    .sol-info { grid-area: info; }
    .sol-top, .sol-bottom { display: flex; flex-direction: column; align-items: stretch; gap: 18px; }
    .sol-col { gap: 12px; }
    .sol li { padding: 6px 0; font-size: clamp(15px, 0.95vw, 18px); }
    .sol h3 { font-size: clamp(24px, 1.75vw, 34px); }
    .sol-top p { font-size: clamp(16px, 1vw, 19px); line-height: 1.65; }
    .sol-chips span { padding: 7px 12px; font-size: clamp(14px, 0.85vw, 16px); }
    .sol-info { gap: 22px; }
    .sol-bottom { gap: 18px; }
    .sol-flow { grid-area: flow; width: 100%; max-width: calc((100svh - var(--header-h) - 110px) * 1.52 + 32px); justify-self: center; padding: clamp(10px, 1vw, 18px); }
    .sol-shots { grid-area: shots; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .svc-ico { flex: none; color: #B8925A; }
  .arr-ico { flex: none; }
  :global([dir="rtl"]) .svc-ico, :global([dir="rtl"]) .arr-ico { transform: scaleX(-1); }
  .svc-note { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--white); border: 1px solid var(--line); font-size: clamp(15px, 0.99vw, 19px); font-weight: 600; color: var(--navy); }
  .svc-note i { width: 7px; height: 7px; flex: none; background: #B8925A; }
