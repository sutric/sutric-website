---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const c = t(Astro.props.lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <img src="/images/logo-white.png" alt={c.meta.title} />
    <span>© {year} {c.footer}</span>
  </div>
</footer>

<style>
  .footer { background: #06111F; color: #9FB0C6; border-top: 1px solid rgba(244,238,228,.08); }
  .inner { padding-block: 40px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  img { height: 32px; width: auto; }
  span { font-size: clamp(14px, 0.924vw, 18px); }
</style>
