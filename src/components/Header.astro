---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const c = t(Astro.props.lang);
---
<header class="header">
  <div class="container inner">
    <a href={c.home} class="logo" aria-label={c.meta.title}><img src="/images/logo-white.png" alt={c.meta.title} /></a>
    <nav aria-label="Main">
      {c.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href={c.switchHref} class="lang" hreflang={c.switchLang} lang={c.switchLang}>{c.switchLabel}</a>
    <a href="#contact" class="cta">{c.cta}<svg class="arr-ico" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5"></path></svg></a>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 20; background: rgba(14,42,43,.97); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(244,238,228,.08); }
  .inner { height: var(--header-h); display: flex; align-items: center; gap: clamp(24px, 3vw, 56px); }
  .logo { flex: none; }
  .logo img { height: clamp(36px, 3vw, 52px); width: auto; max-width: none; }
  nav { display: flex; justify-content: center; gap: clamp(24px, 3.2vw, 64px); flex: 1; flex-wrap: wrap; }
  nav a { font-size: clamp(15px, 1vw, 18px); font-weight: 500; color: #A9C4C1; text-decoration: none; white-space: nowrap; }
  nav a:hover { color: var(--white); }
  .lang { display: inline-flex; align-items: center; min-height: 46px; font-size: 15px; font-weight: 600; color: #F4EEE4; text-decoration: none; padding: 8px 18px; border: 1px solid rgba(244,238,228,.28); white-space: nowrap; flex: none; }
  .lang:hover { border-color: #F4EEE4; color: #F4EEE4; }
  .lang[lang='ar'] { font-family: 'IBM Plex Sans Arabic', sans-serif; }
  .lang[lang='en'] { font-family: 'IBM Plex Sans', sans-serif; }
  .cta { display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 8px 24px; background: var(--teal); color: var(--white); font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap; flex: none; }
  .cta:hover { background: var(--teal-dark); color: var(--white); }
  @media (max-width: 960px) { nav { display: none; } .inner { gap: 12px; } .logo { margin-inline-end: auto; } .logo img { height: 34px; } .lang, .cta { min-height: 40px; font-size: 14px; } }
  .arr-ico { flex: none; }
  @media (max-width: 480px) { .inner { gap: 8px; } .logo img { height: 28px; } .lang { min-height: 36px; padding: 6px 10px; font-size: 13px; } .cta { min-height: 36px; padding: 6px 12px; gap: 6px; font-size: 13px; } .cta .arr-ico { width: 14px; height: 14px; } }
  :global([dir="rtl"]) .arr-ico { transform: scaleX(-1); }
</style>
